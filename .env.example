# Signing secret shown when creating the webhook in the Tailscale admin console.
TAILSCALE_WEBHOOK_SECRET=tskey-webhook-...

# Where alerts go.
MAIL_TO=you@example.com

# Outgoing mail over SMTPS (port 465). Values below are for Cloudflare Email
# Service; SMTP_PASSWORD is an API token with Email Sending: Edit.
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USERNAME=api_token
SMTP_PASSWORD=...
MAIL_SENDER=Monitor <monitor@example.com>
